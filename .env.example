# Copiá este archivo a .env y completá los valores. Nunca subas .env al repo.

# Base de datos (docker compose levanta PostgreSQL en el puerto 5433)
DATABASE_URL="postgresql://mova:mova_local_only@localhost:5433/mova"
# Base exclusiva para tests de integración: se borra y recrea en cada corrida.
TEST_DATABASE_URL="postgresql://mova:mova_local_only@localhost:5433/mova_test"

# URL pública de la app (se usa en los enlaces de los emails)
APP_URL="http://localhost:3000"

# Secreto de sesiones, al menos 32 caracteres aleatorios.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Email: "smtp" envía a Mailpit en desarrollo (http://localhost:8025),
# "console" solo escribe en la terminal.
EMAIL_TRANSPORT="smtp"
SMTP_HOST="localhost"
SMTP_PORT="1025"
EMAIL_FROM="Mova <no-responder@mova.local>"

# Apify (métricas públicas de Instagram, etapa 5). Opcional en la etapa 1.
APIFY_TOKEN=""

# IA (etapa 2). Opcional: sin clave, el asistente de marca queda desactivado y el
# resto de Mova funciona igual. La clave se usa solo en el servidor.
ANTHROPIC_API_KEY=""
# Modelos por defecto: rápido para redactar y sugerir, más capaz para planificar.
AI_MODEL_FAST="claude-haiku-5-5"
AI_MODEL_SMART="claude-sonnet-5-5"

# Imágenes generadas con IA (modo premium, opcional). Sin clave, Mova funciona
# igual en modo estándar. Se usa solo en el servidor. Requiere facturación
# activa en Google AI Studio (el modelo de imágenes no tiene capa gratuita).
GEMINI_API_KEY=""
# Modelo de imágenes. Tiene que estar en modules/images/pricing.ts.
IMAGE_MODEL="gemini-3.1-flash-image"

# Cola de tareas en segundo plano (estrategia semanal). En local corren solas
# después de aprobar, o con `npm run worker`. En un despliegue, un programador
# llama a POST /api/jobs/run con "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
